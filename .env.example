# React frontend (project root)
# In dev, the Vite proxy forwards /api/* to the FastAPI backend.
# Set this only if you want the browser to call the backend directly.
# VITE_API_BASE_URL=http://localhost:8000

# Optional: change where the Vite dev proxy points (default: http://localhost:8000)
# VITE_API_PROXY_TARGET=http://localhost:8000

# Backend (backend/.env)
# GROQ_API_KEY=your_groq_api_key_here
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
